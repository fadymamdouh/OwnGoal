{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },

        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('meta').child('host').val() === auth.uid)"
          }
        },

        "views": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid"
          }
        },

        "actions": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
          "$pushId": {
            ".write": "auth != null && (!data.exists() || root.child('rooms').child($code).child('meta').child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','action']) && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}
